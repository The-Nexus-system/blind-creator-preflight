# Copy this file to .env on the machine that runs the backend, and fill in the
# real value there. The .env file itself is never committed.
# The key lives in backend secrets only: never in this repo, never in the client.
MODEL_API_KEY=
# Funding switch for live model calls. Leave unset (off) until the hackathon
# credit is visible under Billing on the account — while it is off, the
# semantic checks report "uncertain" with the reason instead of calling.
MODEL_CALLS_ENABLED=
PORT=8787
